def parse_args():
    p = argparse.ArgumentParser(description="ICSim_py single-window")
    p.add_argument("-s", "--seed", type=int, default=None)
    p.add_argument("-l", "--level", type=int, default=1, choices=[1, 2])
    p.add_argument("interface", nargs="?", default=None)
    p.add_argument("--channel", default=None)
    return p.parse_args()

ARGS = parse_args()

if ARGS.interface is None:
    if sys.platform.startswith("win"):
        INTERFACE, CHANNEL = "virtual", "test"
    else:
        INTERFACE, CHANNEL = "socketcan", "vcan0"
else:
    INTERFACE = ARGS.interface
    CHANNEL   = ARGS.channel or "vcan0"

