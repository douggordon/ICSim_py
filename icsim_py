# ──────────────────────────────────────────────────────────────
# DoCAN UDS / ISO-TP 
# ──────────────────────────────────────────────────────────────
REQ_ID = 0x740
RESP_ID = 0x680
VIN = "1HGCM82633A123456"
DID_F191 = b"chv_1337"

class UdsServer:
    """Non-blocking ISO-TP/UDS server driven by the pygame event loop."""
    def __init__(self, bus):
        self.bus = bus
        self.session = 0x01
        self.unlocked_f191 = False
        self.rx_expected = 0
        self.rx_buffer = bytearray()
        self.rx_next_seq = 1
        self.tx_pending = None

    def _send_frame(self, data):
        self.bus.send(can.Message(arbitration_id=RESP_ID, data=data, is_extended_id=False))

    def send_payload(self, payload):
        payload = bytes(payload)
        if len(payload) <= 7:
            self._send_frame(bytes([len(payload)]) + payload + bytes(7 - len(payload)))
            return
        length = len(payload)
        first = bytes([0x10 | ((length >> 8) & 0x0F), length & 0xFF]) + payload[:6]
        self._send_frame(first)
        self.tx_pending = {"payload": payload, "index": 6, "seq": 1}

    def _send_consecutive_frames(self, block_size=0):
        if not self.tx_pending:
            return
        sent = 0
        while self.tx_pending["index"] < len(self.tx_pending["payload"]):
            t = self.tx_pending
            chunk = t["payload"][t["index"]:t["index"] + 7]
            frame = bytes([0x20 | (t["seq"] & 0x0F)]) + chunk
            self._send_frame(frame + bytes(8 - len(frame)))
            t["index"] += len(chunk)
            t["seq"] = (t["seq"] + 1) & 0x0F
            sent += 1
            if block_size and sent >= block_size:
                return
        self.tx_pending = None

    def handle_uds(self, request):
        if not request:
            return
        sid = request[0]
        if sid == 0x10 and len(request) >= 2:
            sub = request[1]
            if sub in (0x01, 0x02, 0x03, 0x09):
                self.send_payload(bytes([0x50, sub, 0x00, 0x32, 0x01, 0xF4]))
                if sub == 0x03:
                    self.session = 0x03
                    print("[UDS] Extended session entered (10 03)")
                elif sub == 0x09 and self.session == 0x03:
                    self.unlocked_f191 = True
                    print("[UDS] F191 unlocked")
                elif sub == 0x01:
                    self.session = 0x01
                    self.unlocked_f191 = False
                return
            self.send_payload(bytes([0x7F, 0x10, 0x12]))
            return
        if sid == 0x22 and len(request) >= 3:
            did = (request[1] << 8) | request[2]
            if did == 0xF190:
                self.send_payload(bytes([0x62, 0xF1, 0x90]) + VIN.encode("ascii"))
            elif did == 0xF191:
                if self.unlocked_f191:
                    self.send_payload(bytes([0x62, 0xF1, 0x91]) + DID_F191)
                else:
                    self.send_payload(bytes([0x7F, 0x22, 0x7F]))
            else:
                self.send_payload(bytes([0x7F, 0x22, 0x31]))
            return
        self.send_payload(bytes([0x7F, sid, 0x11]))

    def process_frame(self, msg):
        if msg.arbitration_id != REQ_ID or not msg.data:
            return
        data = bytes(msg.data)
        frame_type = data[0] & 0xF0
        if frame_type == 0x00:
            length = data[0] & 0x0F
            self.handle_uds(data[1:1 + length])
        elif frame_type == 0x10 and len(data) >= 2:
            self.rx_expected = ((data[0] & 0x0F) << 8) | data[1]
            self.rx_buffer = bytearray(data[2:8])
            self.rx_next_seq = 1
            self._send_frame(bytes([0x30, 0x00, 0x00]) + bytes(5))
        elif frame_type == 0x20 and self.rx_expected:
            if (data[0] & 0x0F) != self.rx_next_seq:
                self.rx_expected = 0
                self.rx_buffer.clear()
                return
            self.rx_buffer.extend(data[1:8])
            self.rx_next_seq = (self.rx_next_seq + 1) & 0x0F
            if len(self.rx_buffer) >= self.rx_expected:
                request = bytes(self.rx_buffer[:self.rx_expected])
                self.rx_expected = 0
                self.rx_buffer.clear()
                self.handle_uds(request)
        elif frame_type == 0x30 and self.tx_pending:
            flow_status = data[0] & 0x0F
            if flow_status == 0x00:
                block_size = data[1] if len(data) > 1 else 0
                self._send_consecutive_frames(block_size)
            elif flow_status == 0x02:
                self.tx_pending = None

