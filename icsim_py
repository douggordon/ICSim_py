print(f"Seed: {ARGS.seed}   Level: {ARGS.level}")

# ──────────────────────────────────────────────────────────────
# Randomization
# ──────────────────────────────────────────────────────────────
def make_config(seed):
    if seed is None:
        return dict(door_id=0x19B, signal_id=0x188, speed_id=0x244,
                    door_pos=2, signal_pos=0, speed_pos=3)
    rng = random.Random(seed)
    ids = list(range(0x100, 0x700))
    rng.shuffle(ids)
    door_id, signal_id, speed_id = ids[0], ids[1], ids[2]
    pos = list(range(8))
    rng.shuffle(pos)
    return dict(
        door_id=door_id, signal_id=signal_id, speed_id=speed_id,
        door_pos=pos[0], signal_pos=pos[1],
        speed_pos=rng.choice([0,1,2,3,4,5,6])
    )

CFG = make_config(ARGS.seed)
#print(f"Door  {CFG['door_id']:03X}@{CFG['door_pos']}  "
      #f"Signal {CFG['signal_id']:03X}@{CFG['signal_pos']}  "
