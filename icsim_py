class ICSim_py_App:
    def __init__(self):
        pygame.init()
        self.W, self.H = 1200, 720
        self.win = pygame.Window("ICSim_py", size=(self.W, self.H))
        self.surf = self.win.get_surface()
        self.speed = 0.0
        self.accel = 0.0
        self.doors = 0x00
        self.left = self.right = False
        self.keys = set()
        self.signal_blink = False
        self.last_blink = 0.0
        self.road_offset = 0.0
        self.log = {}                  # id → (ts, msg, prev_data, highlight_until[8])
        self.LOG_TIMEOUT = 5.0
        self.HIGHLIGHT_DURATION = 1.8
        self.highlight = False
        self.show_ascii = False
        self.recording = False
        self.record_file = None
        self.record_path = ""
        self.record_count = 0
        self.high_speed_start = None
        self.challenge1_sent = False
        self.type_buf = ""
        self.challenge2_sent = False
        self.uds = UdsServer(bus)
        self.can_input = ""
        self.can_input_active = False
        self.can_input_status = "Enter frame, then press Enter"
        self.can_input_status_until = 0.0
        self.can_input_rect = pygame.Rect(self.W - 378, self.H - 53, 354, 29)
        self.TX_INTERVAL = {
            "speed":   0.050,   #  50 ms
            "doors":   0.200,   # 200 ms
            "signal":  0.200,   # 200 ms
        }
        self.last_tx = {
            "speed":   0.0,
            "doors":   0.0,
            "signal":  0.0,
        }

        # Difficulty 2 junk – each ID gets its own fixed interval
        self.junk = []
        if ARGS.level >= 2:
            rng = random.Random(ARGS.seed or 1)
            used = {CFG["door_id"], CFG["signal_id"], CFG["speed_id"]}
            possible_intervals = [0.050, 0.100, 0.200, 0.500, 1.000]  # 50/100/200/500/1000 ms
            for _ in range(7):
                while True:
                    aid = rng.randint(0x100, 0x6FF)
                    if aid not in used:
                        used.add(aid)
                        break
                fixed = set(rng.sample(range(8), rng.randint(1, 3)))
                interval = rng.choice(possible_intervals)
                self.junk.append({
                    "id": aid,
                    "data": [0]*8,
                    "fixed_zero": fixed,
                    "interval": interval,      # locked for this ID
                    "last_tx": 0.0,
                })
            #print("Junk IDs + intervals:")
            #for j in self.junk:
                #print(f"  {j['id']:03X}  →  {int(j['interval']*1000)} ms")

        self.particles = []
        self.PARTICLE_MAX = 90
        self.font   = pygame.font.SysFont("consolas", 17)
        self.small  = pygame.font.SysFont("consolas", 14)
        self.medium = pygame.font.SysFont("consolas", 22, bold=True)
        self.big    = pygame.font.SysFont("consolas", 48, bold=True)
        self.tiny   = pygame.font.SysFont("consolas", 13)
